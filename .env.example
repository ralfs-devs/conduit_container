# Copy this file to .env and adjust values to your personal settings

# Required
# Build Process will only start, if values are inserted
SECRET_KEY=
DB_PASSWORD=

DJANGO_ADMIN_USER=
DJANGO_ADMIN_EMAIL=
# Please choose password with at least 8 characters
DJANGO_ADMIN_PASSWORD=

# Set to true only for local debugging
DJANGO_DEBUG=false

# Comma-separated; 
# add host IP for network access, 
# e.g. localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS origins
# for network use add network URL to this list
CORS_WHITELIST=http://localhost:8282,http://127.0.0.1:8282
