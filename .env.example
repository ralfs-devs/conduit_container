# Copy this file to .env and adjust values to your personal settings

# Required
SECRET_KEY=change-me-secret
DB_PASSWORD=change-me-dbpass

# Set to true only for local debugging
DJANGO_DEBUG=false

# Comma-separated; add host IP for network access, e.g. localhost,127.0.0.1,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS origins
CORS_WHITELIST=http://localhost:8282,http://127.0.0.1:8282

# Backend Admin (Superuser) Credentials
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me-admin
